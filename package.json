{
  "name": "tour-editor-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest run",
    "test:itinerary-direct": "vitest run src/lib/itinerary/directInputParser.test.ts src/lib/itinerary/aiParser.test.ts",
    "test:itinerary-golden": "vitest run src/app/api/itinerary/parse/itinerary-golden.test.ts",
    "test:parser": "npm run test:quote-response && npm run test:itinerary-direct && npm run test:itinerary-golden",
    "test:quote-response": "vitest run src/lib/quote/responseParser.test.ts src/lib/quote/responseTemplate.test.ts src/app/api/quote-response/parse/route.test.ts",
    "test:watch": "vitest",
    "verify:parser": "npm run test:parser && npm run quality && git diff --check",
    "benchmark:pdf-parser": "vite-node -c vitest.config.ts scripts/benchmark-pdf-parser.ts",
    "quality": "bash scripts/quality-gate.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "^0.1.80",
    "@tanstack/react-query": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "cfb": "^1.2.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@opendataloader/pdf": "^2.4.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}

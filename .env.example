# .env.example
# 복사: cp .env.example .env.local

# ── Access Gate ───────────────────────────────────────
ACCESS_CODE="change-this-shared-code"

# ── MCP: 하나투어 상품 데이터 ─────────────────────────
USE_MOCK_MCP="true"
HANATOUR_MCP_URL="http://10.225.18.50:8080/mcp"
HANATOUR_MCP_TOKEN=""
HANATOUR_MCP_REQUEST_TIMEOUT_MS="30000"
HANATOUR_MCP_TOOL_CALL_TIMEOUT_MS="60000"

# ── Mock 설정 ─────────────────────────────────────────
USE_MOCK_FLIGHTS="true"
USE_MOCK_COST_REF="true"

# ── OpenAI: 일정 AI 파싱/PDF OCR ──────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_PARSE_TIMEOUT_MS="30000"

# ── 견적답변 이미지 OCR ───────────────────────────────
# openai: Vercel 배포 기본값. 서버 환경변수 OPENAI_API_KEY 사용.
# local: 로컬/서버 Python 환경의 PaddleOCR 실행.
QUOTE_RESPONSE_OCR_PROVIDER="openai"
QUOTE_RESPONSE_OCR_PYTHON_BIN="python3"
QUOTE_RESPONSE_OCR_TIMEOUT_MS="60000"
